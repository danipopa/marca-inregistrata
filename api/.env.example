# Rails API environment variables

# Frontend URL used for Stripe/PayPal return and cancel URLs.
FRONTEND_URL=http://localhost:3000

# Google Sign-In
# Create an OAuth 2.0 Web client in Google Cloud Console.
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com

# Stripe Checkout
# Get this from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me

# PayPal Checkout
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# PayPal does not reliably support RON checkout, so PayPal orders are created in EUR.
PAYPAL_RON_PER_EUR=5

# Optional: create/update an admin user with `bin/rails db:seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password123

# Production database values, used by config/database.yml in production.
DATABASE_NAME=marca_inregistrata_production
DATABASE_CACHE_NAME=marca_inregistrata_cache
DATABASE_QUEUE_NAME=marca_inregistrata_queue
DATABASE_CABLE_NAME=marca_inregistrata_cable
DATABASE_USERNAME=marca
DATABASE_PASSWORD=replace_me
DATABASE_HOST=marca-mysql
DATABASE_PORT=3306
