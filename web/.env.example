# Nuxt frontend environment variables

# Rails API base URL.
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Google Sign-In OAuth 2.0 Web client ID.
NUXT_PUBLIC_GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com

# Visitor analytics: auto selects GA4 if an ID is set, otherwise first-party.
# Explicit choices: google, first-party, none. Development cluster sets none.
NUXT_PUBLIC_ANALYTICS_PROVIDER=auto
NUXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NUXT_PUBLIC_GOOGLE_ANALYTICS_DEBUG=false
NUXT_PUBLIC_SITE_URL=https://inregistrare-marca.com
NUXT_PUBLIC_SITE_INDEXABLE=false
